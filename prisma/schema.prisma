// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Values are lowercase so the generated TypeScript union matches the keys the
// UI already uses in categoryLabels / categoryStyles.
enum NoticeCategory {
  announcement
  help
  event
  lost_found
}

/// One housing company (taloyhtiö). This is the tenant boundary: every row that
/// belongs to a building carries its buildingId, and nothing is ever read
/// without scoping to one.
model Building {
  id            String         @id @default(cuid())
  /// Used in the URL, e.g. /talo/maple-street-12
  slug          String         @unique
  name          String
  residentCount Int            @default(0)
  notices       Notice[]
  infoItems     BuildingInfo[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// The "Good to know" rows on the front page - sauna shifts, caretaker number.
/// A separate table because buildings genuinely differ: not every one has a
/// sauna, some have a gym or a car charger.
model BuildingInfo {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// Key into the icon map in the UI, not a component name.
  icon       String
  label      String
  value      String
  sortOrder  Int      @default(0)

  @@index([buildingId, sortOrder])
}

model Notice {
  id         Int            @id @default(autoincrement())
  buildingId String
  building   Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title      String
  content    String
  category   NoticeCategory
  // Free text until authentication lands - then this becomes a User relation.
  author     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Every read filters by building first, so a createdAt-only index would go
  // unused.
  @@index([buildingId, createdAt])
}
