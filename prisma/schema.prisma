// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Values are lowercase so the generated TypeScript union matches the keys the
// UI already uses in categoryLabels / categoryStyles.
enum NoticeCategory {
  announcement
  help
  event
  lost_found
}

/// One community with its own notice board - an apartment block, a street, a
/// co-working space, a club. This is the tenant boundary: every row that
/// belongs to a community carries its communityId, and nothing is ever read
/// without scoping to one.
model Community {
  id          String          @id @default(cuid())
  /// Used in the URL, e.g. /community/maple-street
  slug        String          @unique
  name        String
  // No memberCount column: a stored count drifts the moment someone joins or
  // leaves without it being updated. Count the memberships instead.
  memberships Membership[]
  notices     Notice[]
  infoItems   CommunityInfo[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// A person with a login. Users are global rather than per community, so one
/// account can belong to several - someone in a housing company and a club.
model User {
  id           String       @id @default(cuid())
  /// Stored lowercased, so "Anna@Example.com" and "anna@example.com" cannot be
  /// two accounts.
  email        String       @unique
  name         String
  /// scrypt hash with its salt and parameters - never the password itself.
  /// Format lives in src/lib/password.ts.
  passwordHash String
  sessions     Session[]
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// One signed-in browser. The cookie holds a random token; this row holds only
/// its SHA-256 hash, so someone who reads the database still cannot sign in as
/// anyone. Deleting the row signs that browser out.
model Session {
  /// SHA-256 of the cookie token, hex encoded.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum MembershipRole {
  member
  admin
}

/// Who belongs to which community. This is what authorisation checks: being
/// signed in only says who you are, a membership says what you may see.
model Membership {
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(member)
  createdAt   DateTime       @default(now())

  // The pair is the key: nobody can be a member of the same community twice.
  // The primary key index starts with userId, which covers "my communities";
  // the second index covers "members of this community".
  @@id([userId, communityId])
  @@index([communityId])
}

/// The "Good to know" rows on a community's home page. A separate table because
/// communities differ: one has a shared laundry and a caretaker, another has
/// meeting times and a contact address.
model CommunityInfo {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// Key into the icon map in the UI, not a component name.
  icon        String
  label       String
  value       String
  sortOrder   Int       @default(0)

  @@index([communityId, sortOrder])
}

model Notice {
  // cuid like every other model. An autoincrement id is a counter shared by
  // every tenant: it makes notice URLs guessable and lets one community read
  // the whole platform's volume off its own ids.
  id          String         @id @default(cuid())
  communityId String
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  content     String
  category    NoticeCategory
  // Free text until authentication lands - then this becomes a User relation.
  author      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Every read filters by community first, so a createdAt-only index would go
  // unused.
  @@index([communityId, createdAt])
}
